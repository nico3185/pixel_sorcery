# ROMs and anything generated from them never go in this repo (public_export.py also refuses
# large binaries and any file matching a known dump's SHA-1 in engine/tools/roms.json)
*.bin
*.md.rom
*.gen
*.smd
*.sfc
*.smc
*.z64
*.68k
*.sms
*.gg
*.32x
*.rom
roms/
# .md is also a Mega Drive ROM extension: Markdown only where the documentation lives
/*.md
!/README.md
!/TUTORIAL.md
!/BACKLOG.md
!/HANDOFF.md
!/PRODUCT.md
games/**/*.md
# discs, BIOS images, saves, archives
*.iso
*.cue
*.chd
*.img
*.srm
*.sav
*.brm
*.zip
*.7z
games/*/src/recomp/
games/*/disasm/
# Third-party input movies and recorded polls
*.gmv
*.bk2
*.polls
# Local paths of reference material
docs/kpi/references.json
# Build output and local tooling
build*/
.venv/
__pycache__/
*.log
*.o
.DS_Store

# Play sessions: per-poll inputs and logs (local)
games/*/sessions/
games/*/movies/*.polls
games/*/movies/*.ck
games/*/movies/*.audio
games/*/movies/*.states/
games/*/movies/play-*

# Robustness harness output and long recordings (local)
robust_report.md
games/*/recordings/
.claude/worktrees/

# Mega CD disc files extracted by cd_extract.py (game data)
games/*/disc/

# funclut.py: the SQLite lookup table, rebuilt from docs/lut/functions.jsonl
docs/lut/functions.db
